# Copy to .env in the project root and edit. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mandi_user
DB_PASSWORD=change_me
DB_NAME=mandi_dashboard

MANDI_API_URL=https://api.dharun.dev/v1/mandi
API_TIMEOUT_SECONDS=30
API_PAGE_LIMIT=100
REFRESH_INTERVAL_HOURS=3

# The dashboard is served by FastAPI itself (same origin), so CORS is only needed
# if you open the UI from a different origin.
CORS_ORIGINS=http://localhost:8000

# Stage 5
APP_ENV=development            # set to "production" for long-lived static caching
DOCS_ENABLED=true              # set to false to hide /docs, /redoc and /openapi.json
MANUAL_REFRESH_COOLDOWN_SECONDS=60
